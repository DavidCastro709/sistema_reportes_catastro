NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/catastro?schema=public"
JWT_SECRET="replace-with-at-least-32-random-bytes"
JWT_EXPIRES_IN=30m
CORS_ORIGIN=http://localhost:8081,http://localhost:8082
# Production must terminate HTTPS at a trusted reverse proxy and set TRUST_PROXY=1
TRUST_PROXY=0
